@page
@model ForgotPasswordConfirmation
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<h1>@ViewData["Title"]</h1>
@if (EmailSender is Pidar.Services.Email.SmtpEmailSender smtp && !smtp.IsConfigured)
{
    <p>
        Password reset by email is not available on this site yet.
        Please ask a PIDAR administrator to send you a password link.
    </p>
}
else
{
    <p>
        If an account exists for that address, you will receive an email with a link to reset your password.
    </p>
}
