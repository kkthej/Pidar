@page
@model ForgotPasswordModel
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1>@ViewData["Title"]</h1>
<h2>Enter your email.</h2>
<hr />
@if (EmailSender is Pidar.Services.Email.SmtpEmailSender smtp && !smtp.IsConfigured)
{
    <div class="alert alert-info">
        Password reset by email is not available on this site yet.
        Please ask a PIDAR administrator to send you a password link.
    </div>
}
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
