@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<div class="col-md-8 col-lg-6 mx-auto text-center mt-4">
    <h2>@ViewData["Title"]</h2>
    @if (Model.DisplayConfirmAccountLink)
    {
        <div class="alert alert-warning text-start mt-3">
            <strong>Local testing only:</strong> SMTP is not configured, so no email was sent.
            <a id="confirm-link" href="@Model.EmailConfirmationUrl">Click here to confirm the account</a>.
        </div>
    }
    else
    {
        <p class="mt-3">
            We have sent a confirmation link to <strong>@Model.Email</strong>.
            Please open it to activate your account, then log in to start describing your dataset.
        </p>
        <p class="text-muted small">
            No email after a few minutes? Check your spam folder, or
            <a asp-page="./ResendEmailConfirmation">send the link again</a>.
        </p>
    }
</div>
