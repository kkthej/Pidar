@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    ViewData["BodyClass"] = "login-page";
}

<div class="login-wrapper">
    <div class="login-card">

        <div class="text-center">
            <img src="/images/sfondo.png" class="login-image" alt="Login Background" />
        </div>

        <form id="account" method="post">
            <h2 class="login-title">Log in to PIDAR</h2>

            @if (Request.Query.ContainsKey("timedOut"))
            {
                <div class="alert alert-info py-2 small" role="status">
                    You were signed out after 15 minutes of inactivity. Please log in again.
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger login-validation"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger login-validation"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger login-validation"></span>
            </div>

            @* No "Remember me": the sign-in always ends when the browser is closed (see Login.cshtml.cs) *@
            <p class="text-muted small mb-3">For security you are signed out when you close the browser or after 15 minutes of inactivity.</p>

            <button id="login-submit" type="submit" class="btn btn-primary w-100 mb-2">Log in</button>

            <div class="text-center mt-2">
                <a asp-page="./ForgotPassword" class="login-forgot">Forgot your password?</a>
                @if (Model.ShowResendConfirmation)
                {
                    <span class="mx-1">·</span>
                    <a asp-page="./ResendEmailConfirmation" class="login-forgot">Resend email confirmation</a>
                }
            </div>
            <div class="text-center mt-3 small">
                Want to contribute a dataset?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create a data provider account</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
