@page
@model RegisterModel
@{
    ViewData["Title"] = "Create a data provider account";
    ViewData["BodyClass"] = "login-page";
}

<div class="login-wrapper">
    <div class="login-card">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2 class="login-title">Create a data provider account</h2>
            <p class="text-muted small">
                With an account you can describe your preclinical imaging dataset in a guided form,
                save it and come back later, and submit it to the PIDAR team for review.
            </p>

            <div asp-validation-summary="ModelOnly" class="text-danger login-validation" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@institution.org" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger login-validation"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">New password</label>
                <span asp-validation-for="Input.Password" class="text-danger login-validation"></span>
            </div>
            <div class="form-floating mb-2">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger login-validation"></span>
            </div>
            <p class="text-muted small mb-3">
                At least 8 characters, with an upper-case letter, a lower-case letter, a digit and a symbol.
            </p>

            @* Honeypot for bots: hidden from people, see RegisterModel.InputModel.Website *@
            <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
                <label for="Input_Website">Website</label>
                <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary w-100 mb-2">Create account</button>

            <p class="text-muted small mt-2 mb-0">
                We will send you an email to confirm your address before your first login.
            </p>
            <div class="text-center mt-3 small">
                Already have an account?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
