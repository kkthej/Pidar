@using Microsoft.AspNetCore.Identity
@using Pidar.Areas.Identity.Data
@inject SignInManager<PidarUser> SignInManager
@inject UserManager<PidarUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark"
               href="#"
               id="adminDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                Hello @User.Identity?.Name!
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow"
                aria-labelledby="adminDropdown">

                <li>
                    <a class="dropdown-item"
                       asp-area="Identity"
                       asp-page="/Account/Manage/Index">
                        Account
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Curator"))
                {
                    <li>
                        <a class="dropdown-item" asp-area="" asp-controller="Synonyms" asp-action="Index">
                            Synonyms
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a class="dropdown-item" asp-area="" asp-controller="Users" asp-action="Index">
                            Users
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           href="/matomo/">
                            Analytics
                        </a>
                    </li>
                }

                <li><hr class="dropdown-divider" /></li>

                <li>
                    <form id="logout-form"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          method="post"
                          class="dropdown-item p-0 m-0">

                        <button type="submit"
                                class="btn btn-link text-danger w-100 text-start px-3">
                            Logout
                        </button>
                    </form>
                </li>

            </ul>
        </li>

        @* Inactivity sign-out: countdown in the session bar (_SessionBar.cshtml), warning 2 minutes before, sign-out after 15 idle minutes *@
        <li hidden>
            <form id="idle-logout-form" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity", timedOut = 1 })" method="post"></form>
        </li>
        <script src="~/js/idle-logout.js" asp-append-version="true" defer
                data-idle-minutes="15" data-warn-seconds="120"
                data-keepalive-url="@Url.Action("KeepAlive", "Session", new { area = "" })"
                data-login-url="@Url.Page("/Account/Login", new { area = "Identity", timedOut = 1 })"></script>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn btn-outline-primary rounded-pill px-3"
               asp-area="Identity"
               asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>