@model PaginatedList<Pidar.Models.Dataset>
@using Microsoft.AspNetCore.Identity
@using Pidar.Areas.Identity.Data
@inject SignInManager<PidarUser> SignInManager
@inject UserManager<PidarUser> UserManager

@{
    ViewData["Title"] = "PIDAR – Datasets";
}

@functions {
    // UNIVERSAL SAFE NESTED PROPERTY GETTER
    public static object? GetNestedSafe(object? obj, string path)
    {
        if (obj == null || String.IsNullOrWhiteSpace(path))
            return null;

        var parts = path.Split('.');
        object? curr = obj;

        foreach (var p in parts)
        {
            if (curr == null) return null;

            var prop = curr.GetType().GetProperty(p);
            if (prop == null) return null;

            curr = prop.GetValue(curr);
        }

        return curr;
    }
}

<div id="sfondo" class="d-flex justify-content-center align-items-start">
    <img src="/images/sfondo.png" class="img-fluid" alt="Background" style="padding-bottom:20px;">
</div>

<h3 class="text-center mb-4">
    The Preclinical Image DAtaset Repository (PIDAR) is a public repository of dataset information of preclinical image datasets from any imaging modality associated to peer-review publications.
</h3>
<h4 class="text-center mb-4"><a asp-controller="Home" asp-action="Xnat">Open preclinical imaging datasets available on XNAT instances</a></h4>

<!-- ---------------- STAT CARDS ---------------- -->
<div class="pidar-stat-container mb-4">
    <div class="row g-4">

        <!-- Datasets -->
        <div class="col-md-4">
            <div class="pidar-stat-card pidar-green">
                <div class="pidar-icon" style="color: rgba(255,255,255,0.85); opacity: 1;">
                    <i class="fa-solid fa-database"></i>
                </div>
                <h3>@ViewData["DatasetCount"]</h3>
                <p>Datasets</p>
            </div>
        </div>

        <!-- Subjects -->
        <div class="col-md-4">
            <div class="pidar-stat-card pidar-white">
                <div class="pidar-icon" style="color: #444; opacity: 1;">
                    <i class="fa-solid fa-mouse"></i>
                </div>
                <h3 class="text-dark">@ViewData["TotalSampleSize"]</h3>
                <p class="text-dark">Total Subjects</p>
            </div>
        </div>

        <!-- Metadata Fields -->
        <div class="col-md-4">
            <div class="pidar-stat-card pidar-red">
                <div class="pidar-icon" style="color: rgba(255,255,255,0.85); opacity: 1;">
                    <i class="fa-solid fa-table-list"></i>
                </div>
                <h3>@ViewData["TableColumnCount"]</h3>
                <p>Metadata Fields</p>
            </div>
        </div>

    </div>
</div>




@{
    // Keep the search (phrase + field) on the results page, in sort links and in pagination
    var currentSearchPhrase = Context.Request.Query["SearchPhrase"].ToString();
    var currentSearchField = (ViewData["SearchField"] as string) ?? Context.Request.Query["SearchField"].ToString();
    if (string.IsNullOrEmpty(currentSearchField)) { currentSearchField = "all"; }
    var isSearch = !string.IsNullOrWhiteSpace(currentSearchPhrase);
    var listAction = isSearch ? "ShowSearchResults" : "Index";
    string? routePhrase = isSearch ? currentSearchPhrase : null;
    string? routeField = isSearch ? currentSearchField : null;
}

<!-- ---------------- SEARCH + CREATE ---------------- -->
<div class="row justify-content-between align-items-center mb-2">

    @if (User.IsInRole("Admin") || User.IsInRole("Curator"))
    {
        <!-- Left side (Admins and Curators) -->
        <div class="col-auto">
            <a class="btn btn-primary" href="/Datasets/Create">
                Create New Dataset
            </a>
        </div>
    }

    <!-- Right side: search with field selector + suggestions -->
    <div class="col-12 col-md-auto ms-auto mt-2 mt-md-0">
        <form method="get" action="/Datasets/SearchResults" id="search-form" autocomplete="off" role="search">
            <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
            <div class="input-group search-box">
                <select name="SearchField" id="SearchField" class="form-select search-field" aria-label="Search in">
                    @foreach (var f in Pidar.Services.OntologySearchService.Fields)
                    {
                        <option value="@f.Key" data-placeholder="@f.Placeholder"
                                selected="@(f.Key == currentSearchField ? "selected" : null)">@f.Label</option>
                    }
                </select>
                <div class="search-input-wrap">
                    <input name="SearchPhrase" id="SearchPhrase" class="form-control"
                           placeholder="@Pidar.Services.OntologySearchService.GetField(currentSearchField).Placeholder"
                           value="@currentSearchPhrase"
                           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggestions" />
                    <ul id="search-suggestions" class="search-suggestions list-unstyled shadow" role="listbox" hidden></ul>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i><span class="d-none d-sm-inline"> Search</span></button>
            </div>
        </form>
    </div>

</div>



<!-- ---------------- TABLE ---------------- -->


<div class="table-responsive shadow-sm">
    <table class="table table-bordered table-striped text-center align-middle">
        <thead class="table-light">
            <tr>
                <th>
                    <a asp-action="@listAction"
                       asp-route-sortOrder="@ViewData["DisplayIdSortParam"]"
                       asp-route-SearchPhrase="@routePhrase"
                       asp-route-SearchField="@routeField">

                        Dataset ID

                        @if ((string?)ViewData["CurrentSort"] == "displayid_desc")
                        {
                            <i class="fas fa-sort-down"></i>
                        }
                        else
                        {
                            <i class="fas fa-sort-up"></i>
                        }

                    </a>
                </th>

                <th>Imaging Modality</th>
                <th>Institution</th>
                <th>Facility</th>
                <th>Species</th>
                <th>Sample Size</th>
                <th>Disease Category</th>
                <th>Disease Model</th>
                <th>Organ / Tissue</th>
                <th>License</th>
                <th class="text-center text-nowrap">Status</th>
                <th class="text-center text-nowrap">Year</th>


                @if (User.IsInRole("Admin") || User.IsInRole("Curator"))
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var ds in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details"
                           asp-route-displayId="@ds.DisplayId"
                           class="fw-bold text-primary text-decoration-none">
                            @ds.DisplayId
                        </a>
                    </td>

                    <!-- NESTED FROM CHILD TABLES -->
                    <td>@GetNestedSafe(ds, "StudyComponent.ImagingModality")</td>
                    <td>@GetNestedSafe(ds, "DatasetInfo.Institution")</td>
                    <td>@GetNestedSafe(ds, "DatasetInfo.ImagingFacility")</td>
                    <td>@GetNestedSafe(ds, "InVivo.Species")</td>
                    <td>@GetNestedSafe(ds, "InVivo.OverallSampleSize")</td>
                    <td>@GetNestedSafe(ds, "InVivo.DiseaseCategory")</td>
                    <td>@GetNestedSafe(ds, "InVivo.DiseaseModel")</td>
                    <td>@GetNestedSafe(ds, "InVivo.OrganOrTissue")</td>
                    <td class="text-center">
                        @{
                            var license = GetNestedSafe(ds, "DatasetInfo.License")?.ToString()?.Trim();
                        }
                        @if (!string.IsNullOrWhiteSpace(license) &&
                                            license.Equals("CC BY", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">
                                <img src="~/images/licenses/cc-by.png"
                                     class="license-logo"
                                     alt="CC BY 4.0"
                                     title="Creative Commons Attribution 4.0" />
                            </a>
                        }
                        else if (!string.IsNullOrWhiteSpace(license) &&
                                            license.Equals("CC BY NC", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener">
                                <img src="~/images/licenses/cc-by-nc.png"
                                     class="license-logo"
                                     alt="CC BY NC"
                                     title="Creative Commons Attribution 4.0" />
                            </a>
                        }
                        else if (!string.IsNullOrWhiteSpace(license) &&
                                            license.Equals("CC BY NC ND", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener">
                                <img src="~/images/licenses/cc-by-nd-nc.png"
                                     class="license-logo"
                                     alt="CC BT NC ND"
                                     title="Creative Commons Attribution 4.0" />
                            </a>
                        }
                        else
                        {
                            @license
                        }
                    </td>

                    <td class="text-center text-nowrap">@GetNestedSafe(ds, "Analyzed.Status")</td>
                    <td class="text-center text-nowrap">@GetNestedSafe(ds, "Analyzed.UpdatedYear")</td>

                    @if (User.IsInRole("Admin") || User.IsInRole("Curator"))
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@ds.DatasetId" class="me-2">Edit</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@ds.DatasetId" class="text-danger">Delete</a>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ---------------- PAGINATION ---------------- -->
<div class="d-flex justify-content-center my-4">
    <nav>
        <ul class="pagination">

            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="@listAction"
                       asp-route-SearchPhrase="@routePhrase"
                       asp-route-SearchField="@routeField"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-sortOrder="@ViewBag.CurrentSort">&laquo;</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link"
                       asp-action="@listAction"
                       asp-route-SearchPhrase="@routePhrase"
                       asp-route-SearchField="@routeField"
                       asp-route-pageNumber="@i"
                       asp-route-sortOrder="@ViewBag.CurrentSort">@i</a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="@listAction"
                       asp-route-SearchPhrase="@routePhrase"
                       asp-route-SearchField="@routeField"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-sortOrder="@ViewBag.CurrentSort">&raquo;</a>
                </li>
            }

        </ul>
    </nav>
</div>

<style>
    .search-box { flex-wrap: nowrap; }
    .search-box .search-field { flex: 0 0 auto; width: auto; max-width: 11rem; }
    .search-input-wrap { position: relative; flex: 1 1 auto; min-width: 14rem; }
    .search-input-wrap .form-control { border-radius: 0; height: 100%; }
    .search-suggestions { position: absolute; top: calc(100% + 2px); left: 0; z-index: 1050; margin: 0;
                          min-width: 100%; width: max-content; max-width: min(34rem, calc(100vw - 2rem));
                          background: var(--bs-body-bg); border: 1px solid var(--bs-border-color);
                          border-radius: .375rem; max-height: 22rem; overflow-y: auto; text-align: left; }
    .search-suggestions li { padding: .45rem .75rem; cursor: pointer; display: flex; justify-content: space-between;
                             gap: .75rem; align-items: baseline; }
    .search-suggestions li.active, .search-suggestions li:hover { background: var(--bs-primary-bg-subtle); }
    .search-suggestions .s-text { overflow-wrap: break-word; min-width: 0; }
    .search-suggestions .s-text strong { color: var(--bs-primary-text-emphasis); }
    .search-suggestions .s-hint { color: var(--bs-secondary-color); font-size: .8rem; white-space: nowrap; }
    .search-suggestions li.empty { cursor: default; color: var(--bs-secondary-color); }
    @@media (max-width: 575.98px) {
        .search-box .search-field { max-width: 8.5rem; }
        .search-input-wrap { min-width: 0; }
        .search-suggestions { width: auto; right: 0; }
        .search-suggestions li { flex-direction: column; gap: 0; }
        .search-suggestions .s-hint { white-space: normal; }
    }
</style>

<script>
(function () {
    const form = document.getElementById('search-form');
    const input = document.getElementById('SearchPhrase');
    const field = document.getElementById('SearchField');
    const list = document.getElementById('search-suggestions');
    if (!form || !input || !field || !list) return;

    let items = [], active = -1, timer = null, lastKey = '';

    // Bold the part that matches the typed text at the start of a word (built with text nodes: no HTML injection)
    function render(text, q) {
        const span = document.createElement('span');
        span.className = 's-text';
        const esc = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp('(^|[^\\p{L}\\p{N}])(' + esc + ')', 'iu');
        const m = re.exec(text);
        if (!m) { span.textContent = text; return span; }
        const start = m.index + m[1].length, end = start + m[2].length;
        span.append(text.slice(0, start));
        const b = document.createElement('strong'); b.textContent = text.slice(start, end); span.append(b);
        span.append(text.slice(end));
        return span;
    }

    function close() { list.hidden = true; input.setAttribute('aria-expanded', 'false'); active = -1; }

    function show(data, q) {
        items = data; active = -1; list.innerHTML = '';
        if (!data.length) {
            const li = document.createElement('li'); li.className = 'empty';
            li.textContent = 'No suggestions — press Enter to search anyway';
            list.append(li);
        }
        data.forEach((s, i) => {
            const li = document.createElement('li');
            li.id = 'sugg-' + i; li.setAttribute('role', 'option');
            li.append(render(s.text, q));
            const hint = document.createElement('span'); hint.className = 's-hint'; hint.textContent = s.hint;
            li.append(hint);
            li.addEventListener('mousedown', e => { e.preventDefault(); choose(i); });
            list.append(li);
        });
        list.hidden = false; input.setAttribute('aria-expanded', 'true');
    }

    function highlight(i) {
        [...list.children].forEach((li, j) => li.classList.toggle('active', j === i));
        active = i;
        if (i >= 0) { list.children[i].scrollIntoView({ block: 'nearest' }); input.setAttribute('aria-activedescendant', 'sugg-' + i); }
        else input.removeAttribute('aria-activedescendant');
    }

    function choose(i) { input.value = items[i].text; close(); form.submit(); }

    async function load() {
        const q = input.value.trim();
        const key = field.value + '|' + q;
        if (q.length < 1) { close(); return; }
        if (key === lastKey && !list.hidden) return;
        lastKey = key;
        try {
            const r = await fetch('/Datasets/Suggest?field=' + encodeURIComponent(field.value) + '&q=' + encodeURIComponent(q));
            if (!r.ok) return;
            const data = await r.json();
            if (input.value.trim() === q) show(data, q);   // ignore late answers
        } catch (e) { /* suggestions are optional */ }
    }

    input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(load, 150); });
    input.addEventListener('focus', () => { if (input.value.trim()) load(); });
    input.addEventListener('blur', () => setTimeout(close, 100));
    input.addEventListener('keydown', e => {
        if (list.hidden || !items.length) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); highlight((active + 1) % items.length); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active <= 0 ? items.length - 1 : active - 1); }
        else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); choose(active); }
        else if (e.key === 'Escape') { close(); }
    });
    field.addEventListener('change', () => {
        input.placeholder = field.selectedOptions[0].dataset.placeholder || '';
        lastKey = ''; input.focus(); if (input.value.trim()) load();
    });
})();
</script>
