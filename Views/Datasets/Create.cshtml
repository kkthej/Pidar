@model Pidar.Models.ViewModels.DatasetCreateViewModel
@using Pidar.Helpers
@using System.Text.Json

@{
    ViewData["Title"] = "Create Dataset";

    bool IsLong(string field)
    {
        return field.Contains("Background") ||
               field.Contains("Description") ||
               field.Contains("Procedure") ||
               field.Contains("Details") ||
               field.Contains("Protocol") ||
               field.Contains("Notes") ||
               field.Contains("Justification");
    }

    string PrettyLabel(string raw)
    {
        raw = raw.Replace("/", " ");

        string formatted = System.Text.RegularExpressions.Regex.Replace(
            raw,
            @"(?<=[a-z0-9])(?=[A-Z][a-z])",
            " "
        );

        return char.ToUpper(formatted[0]) + formatted.Substring(1);
    }

    // ------------ CATEGORY DEFINITIONS ------------
    var categories = CategoryProvider.GetCategories();

    // ------------ PREFILL MAP ------------
    // Base map: derived automatically from CategoryProvider + PrettyLabel.
    // Adding a field to CategoryProvider keeps prefill in sync with no extra work.
    var prefillMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var cat in categories)
    {
        foreach (var field in cat.Value)
        {
            string propName = field.Split('.')[1];
            string label = PrettyLabel(propName).ToLowerInvariant();
            prefillMap[label] = field;
        }
    }

    // Aliases: the only 6 xlsx export labels that differ from PrettyLabel(propertyName).
    // Verified by comparing every CategoryProvider field against the actual xlsx dump.
    // Do NOT add entries here unless PrettyLabel of the C# property genuinely differs
    // from the xlsx column A label — the auto-generated map above handles everything else.
    var aliases = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        // Publication — export uses short display names (strips "Paper" prefix)
        ["authors"] = "Publication.PaperAuthors",
        ["journal"] = "Publication.PaperJournal",
        ["year"] = "Publication.PaperYear",
        ["doi"] = "Publication.PaperDoi",

        // InVivo — export uses short display names from DownloadController.PrettyLabelMap
        ["sample size"] = "InVivo.OverallSampleSize",
        ["organ/tissue"] = "InVivo.OrganOrTissue",
    };

    foreach (var alias in aliases)
        prefillMap[alias.Key] = alias.Value;

    string prefillMapJson = JsonSerializer.Serialize(prefillMap);
}

<h2 class="text-center mb-4">Create New Dataset</h2>

<!-- ── Metadata prefill drop zone ─────────────────────────────────────────────
     data-field-map  : server-built label→field JSON, consumed by metadata-prefill.js
     Supports both the researcher's blank template AND a PIDAR xlsx export.
     ──────────────────────────────────────────────────────────────────────── -->
<div id="prefill-zone"
     class="card mb-4 shadow-sm"
     style="border: 2px dashed #0dcaf0; cursor: pointer;"
     data-field-map="@Html.Raw(Html.Encode(prefillMapJson))">

    <div class="card-body text-center py-4">
        <i class="fa-solid fa-file-excel fa-2x text-success mb-2"></i>
        <p class="mb-1 fw-bold text-info">Drag &amp; drop your filled metadata template (.xlsx)</p>
        <p class="text-muted small mb-2">or click here to browse — the form will be filled automatically</p>
        <input id="prefill-file-input" type="file" accept=".xlsx" class="d-none" />
        <div id="prefill-status" class="mt-2 small"></div>
    </div>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    @Html.AntiForgeryToken()

    <!-- DYNAMIC CATEGORIES -->
    @foreach (var category in categories)
    {
        var color = CategoryProvider.GetColor(category.Key);

        <div class="card mb-4 shadow-sm border-@color">
            <div class="card-header bg-@color text-white fw-bold">@category.Key</div>
            <div class="card-body">

                @foreach (var field in category.Value)
                {
                    string label = field.Split('.')[1];
                    string pretty = PrettyLabel(label);
                    string? value = ObjectHelper.GetValue(Model, field);

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <label class="form-label">@pretty</label>
                        </div>
                        <div class="col-sm-8">

                            @if (IsLong(label))
                            {
                                <textarea class="form-control"
                              name="@field"
                              rows="3">@value</textarea>
                            }
                            else
                            {
                                <input class="form-control"
                                       name="@field"
                                       value="@value" />
                            }

                        </div>
                    </div>
                }

            </div>
        </div>
    }

    <div class="text-center mt-4">
        <button type="submit" class="btn btn-primary px-4">Create</button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- SheetJS: client-side xlsx parsing, no server round-trip -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <!-- Prefill logic: reads data-field-map, detects column layout, fills form -->
    <script src="~/js/metadata-prefill.js" asp-append-version="true"></script>
}
