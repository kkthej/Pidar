@model IReadOnlyList<Pidar.Models.Xnat.XnatPublicProject>
@using System.Text.Json
@using Pidar.Models.Xnat

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.css" />
<script src="https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>

<div class="container py-4">
    <div class="xnat-header">
        <h2>Open preclinical imaging datasets available on XNAT instances</h2>
        <a href="~/plugins/metadata-plugin.zip" asp-append-version="true"
           download class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i> PIDAR Metadata Plugin
        </a>
    </div>

    @{
        var xnatInstances = (ViewBag.XnatInstances as List<XnatInstanceOptions>) ?? new List<XnatInstanceOptions>();

        var projectCountByKey = Model
        .GroupBy(x => x.InstanceKey)
        .ToDictionary(g => g.Key, g => g.Count());

        var mapInstancesJson = JsonSerializer.Serialize(
        xnatInstances.Select(x => new
        {
            key = x.Key,
            name = x.Name,
            url = x.BaseUrl,
            lat = x.Latitude,
            lng = x.Longitude,
            count = projectCountByKey.TryGetValue(x.Key, out var c) ? c : 0
        })
        );
    }

    <div id="xnat-map" role="region" aria-label="Globe showing the XNAT instances connected to PIDAR"></div>
    <div id="xnat-map-nodes" class="xnat-map-nodes" aria-label="Jump to an XNAT instance"></div>
    <p class="map-hint">Drag to rotate the globe &nbsp;·&nbsp; Ctrl + scroll (⌘ + scroll on Mac) to zoom &nbsp;·&nbsp; Click a beacon for details</p>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No public projects found from configured server-side instances.
        </div>
    }
    else
    {
        @foreach (var group in Model
            .GroupBy(x => new { x.InstanceKey, x.InstanceName, x.InstanceBaseUrl }))
        {
            <h4 class="xnat-instance-title" id="xnat-inst-@group.Key.InstanceKey">@group.Key.InstanceName</h4>

            <div class="row g-3 xnat-project-row">
                @foreach (var p in group)
                {
                    <div class="col-12 col-md-6 col-lg-4 xnat-project-col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-1">@p.Id</h5>
                                <div class="xnat-summary is-loading"
                                     data-instance-key="@group.Key.InstanceKey"
                                     data-project-id="@p.Id">
                                    Loading summary…
                                </div>
                                <a class="btn btn-sm btn-outline-primary mt-2"
                                   href="@(p.InstanceBaseUrl + p.Uri)"
                                   target="_blank" rel="noopener">
                                    Open in XNAT
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- ── Map (MapLibre GL globe, OpenFreeMap vector tiles, no API key) ───── -->
<script>
    (function () {
        const instances = @Html.Raw(mapInstancesJson);
        const mapEl = document.getElementById("xnat-map");
        const nodesEl = document.getElementById("xnat-map-nodes");
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const STYLE_URL = "https://tiles.openfreemap.org/styles/positron";
        const COUNTRIES_URL = "https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json";
        const BLUE = "#1a6ebd";

        const nodes = instances.filter(function (i) {
            return Number.isFinite(i.lat) && Number.isFinite(i.lng);
        });
        const byKey = new Map(nodes.map(function (i) { return [i.key, i]; }));

        // Filled by the summaries script once it knows which cards have PIDAR metadata
        let metadataCounts = null;

        // ── Popup content ─────────────────────────────────────────────
        function projectsText(n) {
            return n === 1 ? "1 public project" : n + " public projects";
        }

        function sectionFor(key) {
            return document.getElementById("xnat-inst-" + key);
        }

        function scrollToSection(key) {
            const section = sectionFor(key);
            if (section) section.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
        }

        function buildPopup(inst) {
            const root = document.createElement("div");
            root.className = "xnat-popup";

            const title = document.createElement("div");
            title.className = "xnat-popup-title";
            title.textContent = inst.name;
            root.append(title);

            const count = document.createElement("div");
            count.className = "xnat-popup-count";
            count.textContent = inst.count > 0 ? projectsText(inst.count) : "No public projects reachable right now";
            root.append(count);

            if (metadataCounts && inst.count > 0) {
                const n = metadataCounts[inst.key] || 0;
                const meta = document.createElement("div");
                meta.className = "xnat-popup-count";
                meta.textContent = n + " with PIDAR metadata";
                root.append(meta);
            }

            const actions = document.createElement("div");
            actions.className = "xnat-popup-actions";

            if (sectionFor(inst.key)) {
                const jump = document.createElement("button");
                jump.type = "button";
                jump.className = "xnat-popup-link xnat-popup-jump";
                jump.textContent = "Show projects ↓";
                jump.addEventListener("click", function () { scrollToSection(inst.key); });
                actions.append(jump);
            }

            const link = document.createElement("a");
            link.className = "xnat-popup-link";
            link.href = inst.url;
            link.target = "_blank";
            link.rel = "noopener";
            link.textContent = "Open XNAT instance ↗";
            actions.append(link);

            root.append(actions);
            return root;
        }

        // ── Node chips under the map (also the fallback if the map can't load) ──
        let map = null;
        let popup = null;
        let openKey = null;     // instance whose popup is currently open
        const beacons = new Map();  // instance key -> { el, height } of its 3D beacon

        function setActiveChip(key) {
            nodesEl.querySelectorAll(".xnat-node-chip").forEach(function (chip) {
                chip.setAttribute("aria-pressed", chip.dataset.key === key ? "true" : "false");
            });
            document.querySelectorAll(".xnat-beacon").forEach(function (el) { el.classList.remove("is-active"); });
            if (key && beacons.has(key)) beacons.get(key).el.classList.add("is-active");
        }

        nodes.forEach(function (inst) {
            const chip = document.createElement("button");
            chip.type = "button";
            chip.className = "xnat-node-chip" + (inst.count > 0 ? "" : " is-empty");
            chip.dataset.key = inst.key;
            chip.setAttribute("aria-pressed", "false");

            const dot = document.createElement("span");
            dot.className = "xnat-node-chip-dot";
            dot.setAttribute("aria-hidden", "true");

            const name = document.createElement("span");
            name.textContent = inst.name;

            const badge = document.createElement("span");
            badge.className = "xnat-node-chip-count";
            badge.textContent = inst.count;
            badge.title = projectsText(inst.count);

            chip.append(dot, name, badge);
            chip.addEventListener("click", function () {
                if (map) flyToNode(inst);
                else scrollToSection(inst.key);
            });
            nodesEl.append(chip);
        });

        window.addEventListener("xnat:summaries-ready", function (e) {
            metadataCounts = e.detail || {};
            // Refresh the open popup so it picks up the metadata count
            if (map && openKey) openPopup(byKey.get(openKey));
        });

        if (typeof maplibregl === "undefined") {
            showMapUnavailable();
            return;
        }

        try {
            map = new maplibregl.Map({
                container: mapEl,
                style: STYLE_URL,
                center: [10, 45],
                zoom: 2,
                renderWorldCopies: false,
                cooperativeGestures: true,          // page scroll isn't hijacked by the map
                attributionControl: { compact: true }
            });
        } catch (err) {
            console.warn("[XNAT map] MapLibre could not start (WebGL unavailable?):", err);
            map = null;
            showMapUnavailable();
            return;
        }

        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
        map.addControl(new maplibregl.GlobeControl(), "top-right");

        popup = new maplibregl.Popup({ offset: 14, maxWidth: "300px" });
        popup.on("close", function () { openKey = null; setActiveChip(null); });

        // Countries that host an instance get a light fill. Found by point-in-polygon,
        // so a new instance in a new country needs no code change.
        const countriesPromise = (typeof topojson === "undefined" || nodes.length === 0)
            ? Promise.resolve(null)
            : fetch(COUNTRIES_URL)
                .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                .then(function (topo) {
                    const all = topojson.feature(topo, topo.objects.countries).features;
                    const hits = all.filter(function (f) {
                        return nodes.some(function (n) { return featureContains(f, n.lng, n.lat); });
                    });
                    return { type: "FeatureCollection", features: hits };
                })
                .catch(function (err) {
                    console.warn("[XNAT map] country outlines unavailable:", err);
                    return null;
                });

        map.once("style.load", function () {
            map.setProjection({ type: "globe" });
            map.setSky({ "atmosphere-blend": ["interpolate", ["linear"], ["zoom"], 0, 1, 5, 1, 7, 0] });

            countriesPromise.then(function (fc) {
                if (!fc || fc.features.length === 0) return;
                // Draw below the basemap labels so place names stay readable
                const firstSymbol = map.getStyle().layers.find(function (l) { return l.type === "symbol"; });
                const beforeId = firstSymbol ? firstSymbol.id : undefined;
                map.addSource("xnat-countries", { type: "geojson", data: fc });
                map.addLayer({
                    id: "xnat-countries-fill",
                    type: "fill",
                    source: "xnat-countries",
                    paint: { "fill-color": BLUE, "fill-opacity": 0.12 }
                }, beforeId);
                map.addLayer({
                    id: "xnat-countries-line",
                    type: "line",
                    source: "xnat-countries",
                    paint: { "line-color": BLUE, "line-opacity": 0.45, "line-width": 1 }
                }, beforeId);
            });

        });

        // Fit and place beacons only after the first render, once the globe projection
        // is actually in effect. Placing them earlier leaves them at stale (flat-map)
        // positions until the user moves the map.
        map.once("load", function () {
            fitInitialView();
            addBeacons();
        });

        // ── 3D beacons (HTML markers: glowing core, light beam, pulsing ground rings) ──
        const BEACON_HEIGHT = 64;       // px at scale 1; the beam stands this tall

        // Bigger beacon for instances with more public projects
        function beaconScale(count) {
            if (!count) return 0.75;
            return Math.min(1.35, 0.85 + Math.log10(count) * 0.35);
        }

        function addBeacons() {
            nodes.forEach(function (inst) {
                const scale = beaconScale(inst.count);

                const el = document.createElement("button");
                el.type = "button";
                el.className = "xnat-beacon" + (inst.count > 0 ? "" : " is-empty");
                el.style.setProperty("--s", scale);
                el.setAttribute("aria-label", inst.name + ", " + projectsText(inst.count));
                el.innerHTML =
                    '<span class="xnat-beacon-glow"></span>' +
                    '<span class="xnat-beacon-ring"></span>' +
                    '<span class="xnat-beacon-ring xnat-beacon-ring--late"></span>' +
                    '<span class="xnat-beacon-beam"></span>' +
                    '<span class="xnat-beacon-core"></span>';

                el.addEventListener("click", function (e) {
                    e.stopPropagation();        // don't let the map treat it as a background click
                    openPopup(inst);
                });

                new maplibregl.Marker({
                    element: el,
                    anchor: "bottom",           // beam base sits exactly on the coordinates
                    pitchAlignment: "viewport",
                    rotationAlignment: "viewport",
                    opacityWhenCovered: "0"     // hide beacons on the far side of the globe
                })
                    .setLngLat([inst.lng, inst.lat])
                    .addTo(map);

                beacons.set(inst.key, { el: el, height: BEACON_HEIGHT * scale });
            });
        }

        function openPopup(inst) {
            if (!inst) return;
            const beacon = beacons.get(inst.key);
            popup.setOffset(beacon ? beacon.height + 6 : 14);
            popup.setLngLat([inst.lng, inst.lat]).setDOMContent(buildPopup(inst)).addTo(map);
            openKey = inst.key;     // after addTo: re-adding an open popup fires "close" first
            setActiveChip(inst.key);
        }

        function flyToNode(inst) {
            const target = { center: [inst.lng, inst.lat], zoom: Math.max(map.getZoom(), 4.5) };
            map.once("moveend", function () { openPopup(inst); });
            if (reduceMotion) map.jumpTo(target);
            else map.flyTo(Object.assign({ duration: 2200, essential: false }, target));
        }

        // Open on the European cluster: on a globe, Australia is on the far side anyway,
        // and the chips below the map fly there in one click.
        function fitInitialView() {
            const europe = nodes.filter(function (i) {
                return i.lng > -30 && i.lng < 50 && i.lat > 30 && i.lat < 72;
            });
            const focus = europe.length > 0 ? europe : nodes;

            if (focus.length === 0) {
                map.jumpTo({ center: [10, 30], zoom: 1.5 });
            } else if (focus.length === 1) {
                map.jumpTo({ center: [focus[0].lng, focus[0].lat], zoom: 4 });
            } else {
                const bounds = new maplibregl.LngLatBounds();
                focus.forEach(function (i) { bounds.extend([i.lng, i.lat]); });
                // extra top padding so the beams of the northernmost beacons stay in view
                map.fitBounds(bounds, { padding: { top: 100, bottom: 50, left: 70, right: 70 }, maxZoom: 5, animate: false });
            }
        }

        // ── Helpers ───────────────────────────────────────────────────
        function ringContains(ring, x, y) {
            let inside = false;
            for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
                const xi = ring[i][0], yi = ring[i][1], xj = ring[j][0], yj = ring[j][1];
                if ((yi > y) !== (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi) + xi) inside = !inside;
            }
            return inside;
        }

        function polygonContains(rings, x, y) {
            if (!ringContains(rings[0], x, y)) return false;
            for (let k = 1; k < rings.length; k++) {
                if (ringContains(rings[k], x, y)) return false;   // inside a hole
            }
            return true;
        }

        function featureContains(f, x, y) {
            const g = f.geometry;
            if (!g) return false;
            if (g.type === "Polygon") return polygonContains(g.coordinates, x, y);
            if (g.type === "MultiPolygon") return g.coordinates.some(function (p) { return polygonContains(p, x, y); });
            return false;
        }

        function showMapUnavailable() {
            mapEl.classList.add("is-unavailable");
            mapEl.textContent = "The interactive map can't be shown in this browser. Use the institute buttons below to jump to their projects.";
        }
    })();
</script>

<!-- ── Project summaries ───────────────────────────────────────────── -->
<script>
    (async function () {
        const controller = new AbortController();
        window.addEventListener("beforeunload", function () { controller.abort(); }, { once: true });

        const fields = [
            ["displayId",       "Dataset ID"],
            ["species",         "Species"],
            ["organOrTissue",   "Organ/Tissue"],
            ["diseaseCategory", "Disease Category"],
            ["diseaseModel",    "Disease Model"],
            ["imagingModality", "Imaging Modality"],
            ["sampleSize",      "Sample Size"]
        ];

        function setMessage(el, text) {
            const span = document.createElement("span");
            span.className = "is-empty";
            span.textContent = text;
            el.replaceChildren(span);
        }

        const els = Array.from(document.querySelectorAll(".xnat-summary[data-instance-key]"));

        await Promise.all(els.map(async function (el) {
            const instanceKey = el.dataset.instanceKey;
            const projectId = el.dataset.projectId;
            const cardCol = el.closest(".xnat-project-col");

            try {
                const url = "/Home/XnatSummary?instanceKey=" + encodeURIComponent(instanceKey)
                          + "&projectId=" + encodeURIComponent(projectId);
                const resp = await fetch(url, { signal: controller.signal });

                // No PIDAR metadata file on this project → hide the card
                if (resp.status === 404) {
                    if (cardCol) cardCol.remove();
                    return;
                }

                if (!resp.ok) throw new Error("HTTP " + resp.status);

                const s = await resp.json();
                el.classList.remove("is-loading");

                const lines = fields
                    .filter(function (f) { return s[f[0]] !== null && s[f[0]] !== undefined && s[f[0]] !== ""; })
                    .map(function (f) {
                        const row = document.createElement("div");
                        const label = document.createElement("b");
                        label.textContent = f[1] + ": ";
                        row.append(label, document.createTextNode(String(s[f[0]])));
                        return row;
                    });

                if (lines.length) el.replaceChildren.apply(el, lines);
                else setMessage(el, "No summary available.");
            } catch (err) {
                if (err.name !== "AbortError") {
                    el.classList.remove("is-loading");
                    setMessage(el, "Summary unavailable.");
                }
            }
        }));

        // Remove instance groups whose cards were all hidden
        document.querySelectorAll(".xnat-project-row").forEach(function (row) {
            if (row.querySelectorAll(".xnat-project-col").length === 0) {
                const heading = row.previousElementSibling;
                if (heading && heading.tagName === "H4") heading.remove();
                row.remove();
            }
        });

        // Tell the map how many visible cards (projects with PIDAR metadata) each instance has
        const visible = {};
        document.querySelectorAll(".xnat-summary[data-instance-key]").forEach(function (el) {
            const key = el.dataset.instanceKey;
            visible[key] = (visible[key] || 0) + 1;
        });
        window.dispatchEvent(new CustomEvent("xnat:summaries-ready", { detail: visible }));
    })();
</script>
