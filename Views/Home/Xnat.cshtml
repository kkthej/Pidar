@model IReadOnlyList<Pidar.Models.Xnat.XnatPublicProject>
@using System.Text.Json
@using Pidar.Models.Xnat

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

<div class="container py-4">
    <div class="xnat-header">
        <h2>Open preclinical imaging datasets available on XNAT instances</h2>
        <a href="~/plugins/metadata-plugin.zip" asp-append-version="true"
           download class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i> PIDAR Metadata Plugin
        </a>
    </div>

    @{
        var xnatInstances = (ViewBag.XnatInstances as List<XnatInstanceOptions>) ?? new List<XnatInstanceOptions>();

        var projectCountByKey = Model
        .GroupBy(x => x.InstanceKey)
        .ToDictionary(g => g.Key, g => g.Count());

        var mapInstancesJson = JsonSerializer.Serialize(
        xnatInstances.Select(x => new
        {
            key = x.Key,
            name = x.Name,
            url = x.BaseUrl,
            lat = x.Latitude,
            lng = x.Longitude,
            count = projectCountByKey.TryGetValue(x.Key, out var c) ? c : 0
        })
        );

        var cartoKeyJson = JsonSerializer.Serialize((string)(ViewBag.CartoApiKey ?? ""));
    }

    <div id="xnat-map"></div>
    <p class="map-hint">🖱 Scroll to zoom &nbsp;·&nbsp; Drag to pan &nbsp;·&nbsp; Click a pin for details</p>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No public projects found from configured server-side instances.
        </div>
    }
    else
    {
        @foreach (var group in Model
            .GroupBy(x => new { x.InstanceKey, x.InstanceName, x.InstanceBaseUrl }))
        {
            <h4 class="xnat-instance-title">@group.Key.InstanceName</h4>

            <div class="row g-3 xnat-project-row">
                @foreach (var p in group)
                {
                    <div class="col-12 col-md-6 col-lg-4 xnat-project-col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-1">@p.Id</h5>
                                <div class="xnat-summary is-loading"
                                     data-instance-key="@group.Key.InstanceKey"
                                     data-project-id="@p.Id">
                                    Loading summary…
                                </div>
                                <a class="btn btn-sm btn-outline-primary mt-2"
                                   href="@(p.InstanceBaseUrl + p.Uri)"
                                   target="_blank" rel="noopener">
                                    Open in XNAT
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- ── Map ─────────────────────────────────────────────────────────── -->
<script>
    (function () {
        const instances = @Html.Raw(mapInstancesJson);
        const cartoKey = @Html.Raw(cartoKeyJson);
        const mapEl = document.getElementById("xnat-map");

        // Don't zoom out so far that a wide map shows several copies of the world
        const minZoom = Math.max(1, Math.floor(Math.log2(mapEl.clientWidth / 256)));

        const map = L.map(mapEl, {
            scrollWheelZoom: true,
            worldCopyJump: true,
            minZoom: minZoom,
            maxBounds: [[-85, -540], [85, 540]],   // no panning past the poles
            maxBoundsViscosity: 1.0
        });

        // CARTO with key if configured, otherwise keyless OpenStreetMap
        if (cartoKey) {
            L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=" + encodeURIComponent(cartoKey), {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                subdomains: "abcd",
                maxZoom: 18
            }).addTo(map);
        } else {
            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 18
            }).addTo(map);
        }

        // ── Country highlight ─────────────────────────────────────────
        // Bounding-box lookup: lat range, lng range → ISO-A3 code.
        // Add an entry here whenever an instance is added in a new country.
        const countryBoxes = [
            { lat: [36, 47],   lng: [6, 18],    iso: "ITA" },  // Italy
            { lat: [-44, -10], lng: [113, 154], iso: "AUS" }   // Australia
        ];

        function guessCountry(lat, lng) {
            for (const c of countryBoxes) {
                if (lat >= c.lat[0] && lat <= c.lat[1] &&
                    lng >= c.lng[0] && lng <= c.lng[1]) return c.iso;
            }
            return null;
        }

        const validInstances = instances.filter(function (i) {
            return typeof i.lat === "number" && typeof i.lng === "number";
        });

        const toHighlight = new Set(
            validInstances.map(function (i) { return guessCountry(i.lat, i.lng); }).filter(Boolean)
        );

        if (toHighlight.size > 0) {
            fetch("https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries.geojson")
                .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                .then(function (geojson) {
                    L.geoJSON(geojson, {
                        filter: function (f) { return toHighlight.has(f.properties.ISO_A3); },
                        style: {
                            fillColor: "#1a6ebd",
                            fillOpacity: 0.15,
                            color: "#1a6ebd",
                            weight: 1.5,
                            opacity: 0.5
                        },
                        interactive: false
                    }).addTo(map);
                })
                .catch(function (err) { console.warn("[XNAT map] country outlines unavailable:", err); });
        }

        // ── Markers ───────────────────────────────────────────────────
        const pinIcon = L.divIcon({
            className: "xnat-pin",
            html: '<div class="xnat-pin-inner"><div class="xnat-pin-dot"></div><div class="xnat-pin-pulse"></div></div>',
            iconSize: [22, 22],
            iconAnchor: [11, 11],
            popupAnchor: [0, -14]
        });

        function buildPopup(inst) {
            const root = document.createElement("div");
            root.className = "xnat-popup";

            const title = document.createElement("div");
            title.className = "xnat-popup-title";
            title.textContent = inst.name;

            const count = document.createElement("div");
            count.className = "xnat-popup-count";
            count.textContent = "📁 " + (inst.count === 1 ? "1 public project" : inst.count + " public projects");

            const link = document.createElement("a");
            link.className = "xnat-popup-link";
            link.href = inst.url;
            link.target = "_blank";
            link.rel = "noopener";
            link.textContent = "Open XNAT instance ↗";

            root.append(title, count, link);
            return root;
        }

        const markers = validInstances.map(function (inst) {
            return L.marker([inst.lat, inst.lng], { icon: pinIcon })
                .addTo(map)
                .bindPopup(buildPopup(inst));
        });

        // Auto-fit to show all markers
        if (markers.length === 1) {
            map.setView(markers[0].getLatLng(), 6);
        } else if (markers.length > 1) {
            map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [60, 60], maxZoom: 8 });
        } else {
            map.setView([20, 10], minZoom);
        }
    })();
</script>

<!-- ── Project summaries ───────────────────────────────────────────── -->
<script>
    (async function () {
        const controller = new AbortController();
        window.addEventListener("beforeunload", function () { controller.abort(); }, { once: true });

        const fields = [
            ["displayId",       "Dataset ID"],
            ["species",         "Species"],
            ["organOrTissue",   "Organ/Tissue"],
            ["diseaseCategory", "Disease Category"],
            ["diseaseModel",    "Disease Model"],
            ["imagingModality", "Imaging Modality"],
            ["sampleSize",      "Sample Size"]
        ];

        function setMessage(el, text) {
            const span = document.createElement("span");
            span.className = "is-empty";
            span.textContent = text;
            el.replaceChildren(span);
        }

        const els = Array.from(document.querySelectorAll(".xnat-summary[data-instance-key]"));

        await Promise.all(els.map(async function (el) {
            const instanceKey = el.dataset.instanceKey;
            const projectId = el.dataset.projectId;
            const cardCol = el.closest(".xnat-project-col");

            try {
                const url = "/Home/XnatSummary?instanceKey=" + encodeURIComponent(instanceKey)
                          + "&projectId=" + encodeURIComponent(projectId);
                const resp = await fetch(url, { signal: controller.signal });

                // No PIDAR metadata file on this project → hide the card
                if (resp.status === 404) {
                    if (cardCol) cardCol.remove();
                    return;
                }

                if (!resp.ok) throw new Error("HTTP " + resp.status);

                const s = await resp.json();
                el.classList.remove("is-loading");

                const lines = fields
                    .filter(function (f) { return s[f[0]] !== null && s[f[0]] !== undefined && s[f[0]] !== ""; })
                    .map(function (f) {
                        const row = document.createElement("div");
                        const label = document.createElement("b");
                        label.textContent = f[1] + ": ";
                        row.append(label, document.createTextNode(String(s[f[0]])));
                        return row;
                    });

                if (lines.length) el.replaceChildren.apply(el, lines);
                else setMessage(el, "No summary available.");
            } catch (err) {
                if (err.name !== "AbortError") {
                    el.classList.remove("is-loading");
                    setMessage(el, "Summary unavailable.");
                }
            }
        }));

        // Remove instance groups whose cards were all hidden
        document.querySelectorAll(".xnat-project-row").forEach(function (row) {
            if (row.querySelectorAll(".xnat-project-col").length === 0) {
                const heading = row.previousElementSibling;
                if (heading && heading.tagName === "H4") heading.remove();
                row.remove();
            }
        });
    })();
</script>