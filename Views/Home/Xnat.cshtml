@model IReadOnlyList<Pidar.Models.Xnat.XnatPublicProject>

<div class="container py-4">
    <h2 class="mb-3">Public preclinical datasets in XNAT instances</h2>



    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No public projects found from configured server-side instances.
        </div>
    }
    else
    {
        @foreach (var group in Model
            .GroupBy(x => new { x.InstanceKey, x.InstanceName, x.InstanceBaseUrl }))
        {
            <h4 class="mt-4">@group.Key.InstanceName</h4>

            <div class="row g-3">
                @foreach (var p in group)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="small text-muted">@group.Key.InstanceKey</div>
                                <h5 class="card-title mb-1">@p.Id</h5>


                                @if (!string.IsNullOrWhiteSpace(p.PiFullName))
                                {
                                    <div class="small text-secondary mb-1">
                                        PI: @p.PiFullName
                                    </div>
                                }
                                <div class="mt-2 small text-muted" id="summary-@group.Key.InstanceKey-@p.Id">Loading summary…</div>

                                <a class="btn btn-sm btn-outline-primary"
                                   href="@(p.InstanceBaseUrl + p.Uri)"
                                   target="_blank">
                                    Open in XNAT
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }


</div>


<script>
    (async function () {
        const controller = new AbortController();
        window.addEventListener("beforeunload", () => controller.abort(), { once: true });

        const els = [...document.querySelectorAll("[id^='summary-']")];

        await Promise.all(els.map(async (el) => {
            const parts = el.id.split("-");
            const instanceKey = parts[1];
            const projectId = parts.slice(2).join("-");

            // The card column wrapper is 3 levels up: summary-div → card-body → card → col
            const cardCol = el.closest(".col-12");

            try {
                const url = `/Home/XnatSummary?instanceKey=${encodeURIComponent(instanceKey)}&projectId=${encodeURIComponent(projectId)}`;
                const resp = await fetch(url, { signal: controller.signal });

                // 404 means the project was deleted (no metadata JSON) — remove the card entirely
                if (resp.status === 404) {
                    if (cardCol) cardCol.remove();
                    return;
                }

                if (!resp.ok) {
                    throw new Error(`HTTP ${resp.status}`);
                }

                const s = await resp.json();

                const lines = [];
                if (s.displayId)       lines.push(`<div><b>Dataset ID:</b> ${s.displayId}</div>`);
                if (s.species)         lines.push(`<div><b>Species:</b> ${s.species}</div>`);
                if (s.organOrTissue)   lines.push(`<div><b>Organ/Tissue:</b> ${s.organOrTissue}</div>`);
                if (s.diseaseModel)    lines.push(`<div><b>Disease Model:</b> ${s.diseaseModel}</div>`);
                if (s.imagingModality) lines.push(`<div><b>Imaging Modality:</b> ${s.imagingModality}</div>`);
                if (s.sampleSize)      lines.push(`<div><b>Sample Size:</b> ${s.sampleSize}</div>`);

                el.classList.remove("text-muted");
                el.innerHTML = lines.length
                    ? lines.join("")
                    : "<span class='text-muted'>No summary available.</span>";
            } catch (err) {
                if (err.name !== "AbortError") {
                    el.innerHTML = "<span class='text-muted'>Summary unavailable.</span>";
                }
            }
        }));

        // After all cards are processed, hide any instance group headings
        // whose row ended up with no remaining cards
        document.querySelectorAll(".row.g-3").forEach(row => {
            if (row.querySelectorAll(".col-12").length === 0) {
                const heading = row.previousElementSibling;
                if (heading && heading.tagName === "H4") heading.remove();
                row.remove();
            }
        });
    })();
</script>