@model Pidar.Helpers.StatisticsBuilder.Result
@using Pidar.Helpers
@{
    ViewData["Title"] = "Statistics";

    // segment colours for the "Study design & sharing" bars; "Not stated" is always grey
    string SegColor(string label, int i) =>
        label == StatisticsBuilder.NotStated ? "#c9c8c2" : new[] { "#2a78d6", "#eb6834", "#1baf7a", "#8a8984" }[Math.Min(i, 3)];
}

@functions {
    // Horizontal bar list: label · bar · count. Zero rows are grey with an empty track.
    public Microsoft.AspNetCore.Html.IHtmlContent Bars(IEnumerable<StatisticsBuilder.Bar> bars, int labelWidth, bool hintInline = false)
    {
        var list = bars.ToList();
        var max = Math.Max(1, list.Count == 0 ? 1 : list.Max(b => b.Count));
        var sb = new System.Text.StringBuilder($"<div class=\"st-bars\" style=\"--lw:{labelWidth}px\">");
        foreach (var b in list)
        {
            var label = System.Net.WebUtility.HtmlEncode(b.Label);
            var hint = System.Net.WebUtility.HtmlEncode(b.Hint ?? "");
            var width = b.Count == 0 ? 0 : Math.Max(2.0, b.Count * 100.0 / max);
            var tip = $"{label}: {b.Count} dataset{(b.Count == 1 ? "" : "s")}{(hint.Length > 0 && !hintInline ? " · " + hint : "")}";
            sb.Append($"<div class=\"st-row{(b.Count == 0 ? " zero" : "")}\" title=\"{tip}\">");
            sb.Append($"<div class=\"st-lab\">{label}{(hintInline && hint.Length > 0 ? $" <small>{hint}</small>" : "")}</div>");
            sb.Append($"<div class=\"st-track\"><div class=\"st-fill\" style=\"width:{width.ToString(System.Globalization.CultureInfo.InvariantCulture)}%\"></div></div>");
            sb.Append($"<div class=\"st-num\">{b.Count}</div></div>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.Append("</div>").ToString());
    }
}

<style>
    .st-page { --ink2:#52514e; --muted:#8a8984; --gray:#c9c8c2; --s1:#2a78d6; }
    .st-sub { color: var(--ink2); }
    .st-kpis { display:grid; grid-template-columns:repeat(6, 1fr); gap:14px; margin-bottom:18px; }
    .st-kpi { background:#fff; border:1px solid #e6e6e3; border-radius:12px; padding:14px 16px; }
    .st-kpi .v { font-size:30px; font-weight:650; line-height:1.1; }
    .st-kpi .v small { font-size:17px; color:var(--muted); font-weight:500; }
    .st-kpi .l { color:var(--ink2); font-size:13.5px; margin-top:4px; }
    .st-kpi .h { color:var(--muted); font-size:12px; }
    .st-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
    .st-card { background:#fff; border:1px solid #e6e6e3; border-radius:12px; padding:18px 20px; min-width:0; }
    .st-card.full { grid-column:1 / -1; }
    .st-card h3 { font-size:17px; font-weight:600; margin:0; }
    .st-card .d { color:var(--ink2); font-size:13px; margin:3px 0 14px; }
    .st-note { color:var(--muted); font-size:12px; margin-top:10px; }
    .st-row { display:grid; grid-template-columns:var(--lw) 1fr 34px; gap:10px; align-items:center; font-size:13.5px; margin:7px 0; }
    .st-lab { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .st-lab small { color:var(--muted); }
    .st-fill { height:16px; background:var(--s1); border-radius:0 4px 4px 0; }
    .st-num { text-align:right; color:var(--ink2); font-variant-numeric:tabular-nums; }
    .st-row.zero .st-lab, .st-row.zero .st-num { color:var(--muted); }
    .st-row.zero .st-track { border-left:2px solid var(--gray); height:16px; }
    .st-years { display:flex; align-items:flex-end; gap:24px; height:180px; padding:0 8px; border-bottom:1px solid #ecebe7; }
    .st-years .c { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; }
    .st-years .bar { width:56%; max-width:120px; background:var(--s1); border-radius:4px 4px 0 0; }
    .st-years .n { font-size:13px; color:var(--ink2); margin-bottom:4px; }
    .st-yearlab { display:flex; gap:24px; padding:6px 8px 0; }
    .st-yearlab div { flex:1; text-align:center; font-size:13px; color:var(--ink2); }
    .st-seg-block { margin:4px 0 18px; }
    .st-seg-head { display:flex; justify-content:space-between; font-size:13.5px; margin-bottom:5px; }
    .st-seg-head span { color:var(--ink2); }
    .st-seg { display:flex; gap:2px; height:22px; }
    .st-seg div { display:flex; align-items:center; padding-left:7px; color:#fff; font-size:12px; font-weight:600; overflow:hidden; white-space:nowrap; }
    .st-seg div:first-child { border-radius:4px 0 0 4px; }
    .st-seg div:last-child { border-radius:0 4px 4px 0; }
    .st-legend { display:flex; flex-wrap:wrap; gap:4px 14px; font-size:12.5px; color:var(--ink2); margin-top:6px; }
    .st-legend i { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:5px; vertical-align:-1px; }
    @@media (max-width: 991.98px) { .st-kpis { grid-template-columns:repeat(3, 1fr); } }
    @@media (max-width: 767.98px) {
        .st-grid { grid-template-columns:1fr; }
        .st-kpis { grid-template-columns:repeat(2, 1fr); gap:10px; }
        .st-kpi .v { font-size:26px; }
        .st-years { gap:10px; } .st-yearlab { gap:10px; }
        .st-row { grid-template-columns:min(var(--lw), 46%) 1fr 28px; font-size:13px; }
        .st-lab { white-space:normal; line-height:1.25; }
    }
</style>

<div class="container mt-4 mb-5 st-page">
    <h2 class="mb-1">Statistics</h2>
    <p class="st-sub mb-4">A summary of everything in PIDAR — key numbers first, then one chart per question. Hover a bar for details.</p>

    <!-- KEY NUMBERS -->
    <div class="st-kpis">
        <div class="st-kpi"><div class="v">@Model.Datasets</div><div class="l">datasets</div><div class="h">in the repository</div></div>
        <div class="st-kpi"><div class="v">@Model.Animals</div><div class="l">animals imaged</div><div class="h">sum of sample sizes</div></div>
        <div class="st-kpi"><div class="v">@Model.Countries</div><div class="l">countries</div><div class="h">imaging facilities</div></div>
        <div class="st-kpi"><div class="v">@Model.ModalitiesUsed<small>/@Model.ModalitiesTotal</small></div><div class="l">imaging modalities</div><div class="h">groups represented</div></div>
        <div class="st-kpi"><div class="v">@Model.CategoriesUsed<small>/@Model.CategoriesTotal</small></div><div class="l">disease categories</div><div class="h">main categories covered</div></div>
        <div class="st-kpi"><div class="v">@Model.WithPublication</div><div class="l">with a publication</div><div class="h">of @Model.Datasets datasets</div></div>
    </div>

    <div class="st-grid">

        <div class="st-card">
            <h3>Imaging modality</h3>
            <div class="d">Datasets per modality group · a dataset with several modalities counts in each</div>
            @Bars(Model.Modalities, 80)
            <div class="st-note">Grey = no dataset yet. Hover a row for the full name.</div>
        </div>

        <div class="st-card">
            <h3>Main disease category</h3>
            <div class="d">Datasets per main category (Disease Ontology)</div>
            @Bars(Model.Categories, 225)
            @if (Model.WithoutCategory > 0)
            {
                <div class="st-note">@Model.WithoutCategory @(Model.WithoutCategory == 1 ? "dataset" : "datasets") without a category (e.g. healthy animals).</div>
            }
        </div>

        <div class="st-card">
            <h3>Organs / tissues studied</h3>
            <div class="d">Top 10 · a dataset can study several organs</div>
            @Bars(Model.Organs, 130)
        </div>

        <div class="st-card">
            <h3>Country of imaging facility</h3>
            <div class="d">Where the images were acquired</div>
            @Bars(Model.CountryBars, 130)
        </div>

        <div class="st-card">
            <h3>Animals</h3>
            <div class="d">Datasets and animals per species</div>
            @Bars(Model.Species, 150, hintInline: true)
        </div>

        <div class="st-card">
            <h3>Study design &amp; sharing</h3>
            <div class="d">How datasets are described and shared</div>
            @foreach (var (title, segs) in new[] { ("Sex of animals", Model.Sex), ("Data access", Model.Access), ("Study status", Model.Status) })
            {
                var total = segs.Sum(s => s.Count);
                <div class="st-seg-block">
                    <div class="st-seg-head"><b>@title</b><span>@total datasets</span></div>
                    <div class="st-seg">
                        @for (var i = 0; i < segs.Count; i++)
                        {
                            if (segs[i].Count == 0) { continue; }
                            <div style="flex:@segs[i].Count;background:@SegColor(segs[i].Label, i)" title="@segs[i].Label: @segs[i].Count">@segs[i].Count</div>
                        }
                    </div>
                    <div class="st-legend">
                        @for (var i = 0; i < segs.Count; i++)
                        {
                            <span><i style="background:@SegColor(segs[i].Label, i)"></i>@segs[i].Label (@segs[i].Count)</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="st-card full">
            <h3>Datasets added per year</h3>
            <div class="d">By year of last update</div>
            @if (Model.Years.Count == 0)
            {
                <p class="text-muted">No year recorded yet.</p>
            }
            else
            {
                var maxYear = Math.Max(1, Model.Years.Max(y => y.Count));
                <div class="st-years">
                    @foreach (var y in Model.Years)
                    {
                        <div class="c" title="@y.Label: @y.Count @(y.Count == 1 ? "dataset" : "datasets")">
                            <div class="n">@y.Count</div>
                            <div class="bar" style="height:@((y.Count * 140 / maxYear).ToString())px"></div>
                        </div>
                    }
                </div>
                <div class="st-yearlab">
                    @foreach (var y in Model.Years) { <div>@y.Label</div> }
                </div>
            }
        </div>

    </div>
</div>
