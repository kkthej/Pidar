@model Pidar.Controllers.SubmissionDetailsViewModel
@using Pidar.Models.Submissions
@using Pidar.Services.Submissions
@{
    var s = Model.Submission;
    ViewData["Title"] = SubmissionService.Title(s);
    var missing = Model.Issues.Select(i => i.Path).ToHashSet();
    var comment = Model.Value(ContributionForm.CommentKey);
    int? approvedNow = int.TryParse(TempData["ApprovedDatasetId"]?.ToString(), out var newId) ? newId : null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/contribution.css" asp-append-version="true" />
}

<div class="wz-page">
    <a asp-action="@(Model.IsOwner ? "Index" : "Review")" class="small text-decoration-none">
        <i class="bi bi-arrow-left"></i> @(Model.IsOwner ? "My contributions" : "Contributions to review")
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-1 mb-3">
        <div>
            <h2 class="h4 mb-1">@SubmissionService.Title(s)</h2>
            <div class="small text-muted">
                <span class="badge text-bg-@SubmissionStatus.Color(s.Status)">@SubmissionStatus.Label(s.Status)</span>
                · from <a href="mailto:@s.OwnerEmail">@s.OwnerEmail</a>
                @if (s.SubmittedAt.HasValue)
                {
                    <text> · submitted @s.SubmittedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</text>
                }
                @if (s.ReviewedAt.HasValue)
                {
                    <text> · reviewed @s.ReviewedAt.Value.ToString("yyyy-MM-dd") by @s.ReviewedBy</text>
                }
            </div>
        </div>
        @if (Model.IsOwner && SubmissionStatus.IsEditableByOwner(s.Status))
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@s.Id">Continue editing</a>
        }
    </div>

    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success">
            @msg
            @if (approvedNow.HasValue)
            {
                <div class="mt-1">
                    <a class="btn btn-sm btn-success" asp-controller="Datasets" asp-action="Edit" asp-route-id="@approvedNow">
                        Open the new dataset to add ontology codes
                    </a>
                </div>
            }
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-warning">@err</div>
    }

    @if (s.Status == SubmissionStatus.Approved && s.ApprovedDatasetId.HasValue && !approvedNow.HasValue)
    {
        <div class="alert alert-success small">
            Published as a PIDAR dataset.
            @if (!Model.IsOwner)
            {
                <a asp-controller="Datasets" asp-action="Edit" asp-route-id="@s.ApprovedDatasetId">Edit the dataset</a>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(s.ReviewerComment) && s.Status != SubmissionStatus.Approved)
    {
        <div class="alert alert-warning">
            <div class="fw-bold">Message from the PIDAR team</div>
            <div class="wz-pre">@s.ReviewerComment</div>
        </div>
    }

    <!-- ── Review actions (Admin / Curator, submission waiting for review) ── -->
    @if (Model.CanReview)
    {
        <div class="card wz-review-panel mb-4">
            <div class="card-body">
                <h3 class="h6 mb-2"><i class="bi bi-clipboard-check"></i> Review</h3>
                @if (Model.Issues.Count > 0)
                {
                    <p class="small text-warning-emphasis mb-2">
                        <i class="bi bi-exclamation-triangle"></i>
                        @Model.Issues.Count answer(s) are missing or badly formatted (marked below). You can still approve and fix them in the dataset editor, or ask the provider to complete them.
                    </p>
                }
                <div class="row g-3">
                    <div class="col-md-4">
                        <form asp-action="Approve" asp-route-id="@s.Id" method="post"
                              onsubmit="return confirm('Create a public PIDAR dataset from this submission?');">
                            <button type="submit" class="btn btn-success w-100"><i class="bi bi-check2-circle"></i> Approve and publish</button>
                            <div class="form-text">Creates the dataset (like Create Dataset). You can then add ontology codes in the editor.</div>
                        </form>
                    </div>
                    <div class="col-md-8">
                        <form method="post" class="d-flex flex-column gap-2">
                            <textarea name="comment" class="form-control" rows="3" required
                                      placeholder="Message to the data provider: what to complete or correct (or why it is not accepted). It is sent by email."></textarea>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-warning" asp-action="RequestChanges" asp-route-id="@s.Id">
                                    <i class="bi bi-arrow-return-left"></i> Ask for changes
                                </button>
                                <button type="submit" class="btn btn-outline-danger" asp-action="Reject" asp-route-id="@s.Id"
                                        onclick="return confirm('Reject this submission? The provider will not be able to edit it again.');">
                                    Reject
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(comment))
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="fw-bold small text-uppercase text-muted">Note from the data provider</div>
                <div class="wz-pre">@comment</div>
            </div>
        </div>
    }

    <!-- ── Answers, section by section (hidden questions are not shown) ── -->
    @for (var i = 0; i < ContributionForm.Steps.Count; i++)
    {
        var step = ContributionForm.Steps[i];
        <div class="card mb-3">
            <div class="card-header fw-bold"><i class="bi @step.Icon"></i> @step.Title</div>
            <div class="card-body">
                @foreach (var g in step.Groups)
                {
                    var shown = g.Fields.Where(f => ContributionForm.IsVisible(f, Model.Answers)).ToList();
                    if (shown.Count == 0) { continue; }
                    <div class="wz-view-group">
                        <div class="wz-view-group-title">@g.Title</div>
                        <dl class="row mb-0">
                            @foreach (var f in shown)
                            {
                                var v = Model.Value(f.Path);
                                var isMissing = missing.Contains(f.Path);
                                <dt class="col-sm-4 fw-normal text-muted">@f.Label</dt>
                                <dd class="col-sm-8 @(isMissing ? "wz-missing" : "")">
                                    @if (string.IsNullOrWhiteSpace(v))
                                    {
                                        <span class="text-muted">@(f.Required ? "— missing" : "—")</span>
                                    }
                                    else
                                    {
                                        <span class="wz-pre">@ShowValue(f, v)</span>
                                        @if (isMissing)
                                        {
                                            <span class="small text-danger ms-1">@Model.Issues.First(x => x.Path == f.Path).Message</span>
                                        }
                                    }
                                </dd>
                            }
                        </dl>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    // Choice / Multi answers are shown with their labels (e.g. DUO codes with their names)
    private static string ShowValue(FormField f, string value)
    {
        if (f.Options.Count == 0) return value;
        var parts = f.Kind == FieldKind.Multi
            ? value.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            : new[] { value.Trim() };
        return string.Join(", ", parts.Select(p =>
        {
            var o = f.Options.FirstOrDefault(x => string.Equals(x.Value, p, StringComparison.OrdinalIgnoreCase));
            if (o == null) return p;
            return o.Value.Contains(':') ? $"{o.Label} ({o.Value})" : o.Label;
        }));
    }
}
