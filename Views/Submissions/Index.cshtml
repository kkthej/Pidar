@model List<Pidar.Models.Submissions.DatasetSubmission>
@using Pidar.Models.Submissions
@using Pidar.Services.Submissions
@using Pidar.Infrastructure
@{
    ViewData["Title"] = "My contributions";
    var drafts = Model.Where(s => SubmissionStatus.IsEditableByOwner(s.Status)).ToList();
    var others = Model.Where(s => !SubmissionStatus.IsEditableByOwner(s.Status)).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/contribution.css" asp-append-version="true" />
}

<div class="wz-page">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="h4 mb-1">My contributions</h2>
            <p class="text-muted mb-0">Describe your preclinical imaging datasets for PIDAR. Drafts are saved automatically and only you can see them until you submit.</p>
        </div>
        <form asp-action="New" method="post">
            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Describe a new dataset</button>
        </form>
    </div>

    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-warning">@err</div>
    }
    @if (AppRoles.IsEditor(User))
    {
        <div class="alert alert-light border small">
            <i class="bi bi-person-badge"></i> You are a PIDAR curator:
            <a asp-action="Review">review the contributions sent by data providers</a>.
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card wz-empty text-center">
            <div class="card-body py-5">
                <i class="bi bi-journal-plus display-5 text-primary"></i>
                <h3 class="h5 mt-3">No dataset descriptions yet</h3>
                <p class="text-muted mb-3">
                    The form follows the PIDAR metadata template section by section, with drop-downs and yes/no buttons
                    where possible. You can stop at any time and continue later.
                </p>
                <form asp-action="New" method="post">
                    <button type="submit" class="btn btn-primary btn-lg">Start describing my dataset</button>
                </form>
            </div>
        </div>
    }

    @if (drafts.Count > 0)
    {
        <h3 class="h6 text-uppercase text-muted mt-4">In progress</h3>
        @foreach (var s in drafts)
        {
            var progress = SubmissionService.Progress(SubmissionService.ReadAnswers(s));
            var req = progress.Sum(p => p.Required);
            var filled = progress.Sum(p => Math.Min(p.Filled, p.Required));
            var pct = req == 0 ? 100 : (int)Math.Round(100.0 * filled / req);
            <div class="card wz-sub-card mb-2">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold">@SubmissionService.Title(s)</div>
                            <div class="small text-muted">
                                <span class="badge text-bg-@SubmissionStatus.Color(s.Status)">@SubmissionStatus.Label(s.Status)</span>
                                · last saved @s.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1 align-items-start">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">Continue</a>
                            @if (s.Status == SubmissionStatus.Draft)
                            {
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                                      onsubmit="return confirm('Delete this draft? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="progress flex-grow-1" style="height:6px" role="progressbar" aria-label="Required answers completed" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-success" style="width:@(pct)%"></div>
                        </div>
                        <span class="small text-muted">@pct% of required answers</span>
                    </div>
                    @if (s.Status == SubmissionStatus.NeedsRevision && !string.IsNullOrWhiteSpace(s.ReviewerComment))
                    {
                        <div class="alert alert-warning small mt-2 mb-0">
                            <strong>Changes requested:</strong> <span class="wz-pre">@s.ReviewerComment</span>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @if (others.Count > 0)
    {
        <h3 class="h6 text-uppercase text-muted mt-4">Submitted</h3>
        @foreach (var s in others)
        {
            <div class="card wz-sub-card mb-2">
                <div class="card-body d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">@SubmissionService.Title(s)</div>
                        <div class="small text-muted">
                            <span class="badge text-bg-@SubmissionStatus.Color(s.Status)">@SubmissionStatus.Label(s.Status)</span>
                            @if (s.SubmittedAt.HasValue)
                            {
                                <text> · submitted @s.SubmittedAt.Value.ToString("yyyy-MM-dd")</text>
                            }
                        </div>
                        @if (s.Status == SubmissionStatus.Rejected && !string.IsNullOrWhiteSpace(s.ReviewerComment))
                        {
                            <div class="small mt-1 wz-pre">@s.ReviewerComment</div>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-1 align-items-start">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@s.Id">View</a>
                        <form asp-action="New" method="post">
                            <input type="hidden" name="copyFrom" value="@s.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                    title="Start a new description with the same answers (same lab, PI, funding, access…)">
                                <i class="bi bi-files"></i> Use as starting point
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
